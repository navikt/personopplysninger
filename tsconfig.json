{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "baseUrl": ".",
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "skipLibCheck": true,
        "verbatimModuleSyntax": false,
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["vitest/globals", "@testing-library/jest-dom"]
    },
    "include": [".astro/types.d.ts", "src/**/*", "e2e/**/*", "astro.config.mjs", "playwright.config.ts", "vitest.config.ts"]
}
