{
    "name": "personopplysninger",
    "type": "module",
    "version": "3.6.43",
    "private": true,
    "author": "Nav",
    "license": "MIT",
    "homepage": "http://www.nav.no/person/personopplysninger/",
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=10.0.0"
    },
    "packageManager": "pnpm@10.34.5",
    "scripts": {
        "dev": "concurrently --kill-others-on-fail --names astro,mocks \"pnpm:dev:app\" \"pnpm:dev:mocks\"",
        "dev:app": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
        "dev:mocks": "tsx watch src/mocks/server.ts",
        "start": "node ./dist/server/entry.mjs",
        "preview": "ASTRO_TELEMETRY_DISABLED=1 astro build && PORT=3000 HOST=0.0.0.0 node ./dist/server/entry.mjs",
        "lint": "biome check --no-errors-on-unmatched .",
        "format": "biome format --write --no-errors-on-unmatched .",
        "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
        "prepare": "lefthook install",
        "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test"
    },
    "dependencyComments": {
        "@react-pdf/renderer": "12.12.24: There's an issue with how we built the PDF viewing and newer versions seems to crash the viewing. Keep the version for now. Also, we're discussing moving away from PDF and show a print friendly version istead. 3.4.4 --> 4.3.0",
        "react": "Holdes på versjon 18.3.1 --> 19.0.0",
        "react-dom": "Holdes på versjon 18.3.1 --> 19.0.0",
        "@types/react": "Holdes på versjon 18.3.7 --> 19.0.12",
        "@types/react-dom": "Holdes på 18.3.0 --> 19.0.4",
        "@types/react-test-renderer": "Holdes på 18.3.0 --> 19.0.0"
    },
    "dependencies": {
        "@astrojs/node": "11.0.3",
        "@astrojs/react": "6.0.2",
        "@grafana/faro-web-sdk": "1.14.1",
        "@grafana/faro-web-tracing": "1.14.1",
        "@navikt/aksel-icons": "7.17.4",
        "@navikt/arbeidsforhold": "4.3.1",
        "@navikt/astro-logger": "1.0.0",
        "@navikt/ds-css": "7.17.4",
        "@navikt/ds-react": "7.17.4",
        "@navikt/fnrvalidator": "2.1.5",
        "@navikt/nav-dekoratoren-moduler": "3.2.2",
        "@navikt/nav-office-reception-info": "1.2.0",
        "@react-pdf/renderer": "3.4.4",
        "astro": "7.1.6",
        "buffer": "6.0.3",
        "core-js": "3.41.0",
        "dayjs": "1.11.13",
        "file-saver": "2.0.5",
        "ibantools": "4.5.1",
        "intl": "1.2.5",
        "js-cookie": "3.0.5",
        "node-cache": "5.1.2",
        "pino": "10.3.1",
        "react": "18.3.1",
        "react-collapse": "5.1.1",
        "react-day-picker": "9.6.3",
        "react-dom": "18.3.1",
        "react-hook-form": "7.54.2",
        "react-intl": "7.1.10",
        "react-modal": "3.16.3",
        "react-router-dom": "7.5.3",
        "react-select": "5.10.1",
        "react-transition-group": "4.4.5"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.10",
        "@axe-core/playwright": "4.12.1",
        "@biomejs/biome": "2.5.7",
        "@hono/node-server": "2.1.1",
        "@playwright/test": "1.62.1",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "7.0.0",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.3",
        "@types/file-saver": "2.0.7",
        "@types/js-cookie": "3.0.6",
        "@types/node": "24.10.1",
        "@types/react": "18.3.7",
        "@types/react-dom": "18.3.0",
        "@types/react-modal": "3.16.3",
        "@types/react-router-dom": "5.3.3",
        "@types/react-select": "5.0.1",
        "@types/react-test-renderer": "18.3.0",
        "@types/react-transition-group": "4.4.12",
        "@vitest/coverage-v8": "4.1.10",
        "classnames": "2.5.1",
        "concurrently": "10.0.5",
        "hono": "4.13.4",
        "jsdom": "30.0.1",
        "lefthook": "2.1.10",
        "react-test-renderer": "18.3.1",
        "source-map-explorer": "2.5.3",
        "tsx": "4.23.12",
        "typescript": "6.0.3",
        "vitest": "4.1.10",
        "vitest-fetch-mock": "0.4.5"
    },
    "browserslist": {
        "production": [
            ">0.2% and last 2 versions",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 version"
        ]
    }
}
