---
import { BodyLong, Box, Heading } from "@navikt/ds-react";
import CVogJobbprofil from "@/assets/img/CVogJobbprofil.svg";
import DineSaker from "@/assets/img/DineSaker.svg";
import DSOPIkon from "@/assets/img/DSOP.svg";
import FullmaktIkon from "@/assets/img/Fullmakt.svg";
import INSTIkon from "@/assets/img/Institusjonsopphold.svg";
import Jobbsok from "@/assets/img/LedigeStillinger.svg";
import MEDLIkon from "@/assets/img/MEDL.svg";
import Pensjon from "@/assets/img/Pensjon.svg";
import SkjermingIkon from "@/assets/img/Skjerming.svg";
import Sykefravaer from "@/assets/img/Sykepenger.svg";
import Utbetalinger from "@/assets/img/Utbetalinger.svg";
import AnchorLink from "@/components/anchorlink/AnchorLink.astro";
import { getServerRuntimeConfig } from "@/config/serverRuntimeConfig";
import { basePath } from "@/constants";
import type { Language } from "@/language/language";
import sharedStyles from "@/styles/shared.module.css";
import styles from "@/views/forside/sections/6-flere-opplysninger/Lenker.module.css";
import LinkBox from "./LinkBox.astro";
import { text } from "./lenkerText";

interface Props {
    language: Language;
}

const { language } = Astro.props;
const { dineSakerUrl, utbetalingsoversiktUrl, sykefravaerUrl, pdlUrl, skjermingUrl } = getServerRuntimeConfig(Astro.url);
---

<Box background="surface-default" className={sharedStyles.panel} id="flere-opplysninger">
    <div class={styles.content}>
        <div class={styles.overskrift}>
            <Heading size="medium" level="2">{text.tittel[language]}</Heading>
        </div>
        <AnchorLink language={language} id="flere-opplysninger" />
        <div class={styles.info}>
            <BodyLong>{text.beskrivelse[language]}</BodyLong>
        </div>
        {dineSakerUrl && (
            <LinkBox ikon={DineSaker} tittel={text.dokumentarkivTittel[language]} beskrivelse={text.dokumentarkivBeskrivelse[language]} til={`${dineSakerUrl}${language === "en" ? "?lang=en" : ""}`} />
        )}
        {utbetalingsoversiktUrl && (
            <LinkBox ikon={Utbetalinger} tittel={text.utbetalingerTittel[language]} beskrivelse={text.utbetalingerBeskrivelse[language]} til={utbetalingsoversiktUrl} />
        )}
        {sykefravaerUrl && (
            <LinkBox ikon={Sykefravaer} tittel={text.sykefravaerTittel[language]} beskrivelse={text.sykefravaerBeskrivelse[language]} til={sykefravaerUrl} />
        )}
        <LinkBox ikon={CVogJobbprofil} tittel={text.cvTittel[language]} beskrivelse={text.cvBeskrivelse[language]} til="https://www.nav.no/min-cv" />
        <LinkBox ikon={Jobbsok} tittel={text.stillingssokTittel[language]} beskrivelse={text.stillingssokBeskrivelse[language]} til="https://arbeidsplassen.nav.no/stillinger/lagrede-sok" />
        <LinkBox ikon={Pensjon} tittel={text.pensjonTittel[language]} beskrivelse={text.pensjonBeskrivelse[language]} til="https://www.nav.no/pensjon/opptjening" />
        <LinkBox ikon={INSTIkon} tittel={text.instTittel[language]} beskrivelse={text.instBeskrivelse[language]} til={`${basePath}/${language}/institusjonsopphold`} />
        <LinkBox ikon={DSOPIkon} tittel={text.dsopTittel[language]} beskrivelse={text.dsopBeskrivelse[language]} til={`${basePath}/${language}/dsop`} />
        <LinkBox ikon={MEDLIkon} tittel={text.medlTittel[language]} beskrivelse={text.medlBeskrivelse[language]} til={`${basePath}/${language}/medlemskap-i-folketrygden`} />
        <LinkBox ikon={FullmaktIkon} tittel={text.fullmaktTittel[language]} beskrivelse={text.fullmaktBeskrivelse[language]} til={pdlUrl} />
        <LinkBox ikon={SkjermingIkon} tittel={text.skjermingTittel[language]} beskrivelse={text.skjermingBeskrivelse[language]} til={skjermingUrl} />
    </div>
</Box>
