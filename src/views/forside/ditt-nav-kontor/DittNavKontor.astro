---
import "@navikt/nav-office-reception-info/dist/style.css";
import { BodyShort, Label, Link } from "@navikt/ds-react";
import dittNavKontorIkon from "@/assets/img/DittNavKontor.svg";
import Box from "@/components/box/Box.astro";
import Kilde from "@/components/kilde/Kilde.astro";
import ListElement from "@/components/listelement/ListElement.astro";
import type { Language } from "@/language/language";
import type { EnhetKontaktInfo } from "@/types/enhetKontaktInfo";
import styles from "@/views/forside/ditt-nav-kontor/DittNavKontor.module.css";
import { text } from "./dittNavKontorText";

interface Props {
    language: Language;
    enhetKontaktInformasjon: EnhetKontaktInfo;
}

const { language, enhetKontaktInformasjon } = Astro.props;
const { navn, brukerkontakt } = enhetKontaktInformasjon;
---

{
    navn && brukerkontakt.publikumsmottak && (
        <Box language={language} id="ditt-nav-kontor" tittel={text.tittel[language]} ikon={dittNavKontorIkon} ankerlenke>
            <Fragment slot="beskrivelse">{text.beskrivelse[language]}</Fragment>
            <div class={styles.ingress}>
                <BodyShort>
                    {text.ingress[language]}
                    <Label as="span">{navn}</Label>
                </BodyShort>
            </div>
            <slot name="mottak" />
            <dl class:list={[styles.footer, "list"]}>
                <ListElement language={language} tittel={text.kontaktOverskrift[language]}>
                    <Link href={text.kontaktOssUrl[language]}>{text.kontaktLenke[language]}</Link>
                </ListElement>
            </dl>
            <Kilde kilde={text.kildeNav[language]} />
        </Box>
    )
}
