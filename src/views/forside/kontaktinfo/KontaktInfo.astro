---
import { Heading } from "@navikt/ds-react";
import kontaktIkon from "@/assets/img/Kontakt.svg";
import Box from "@/components/box/Box.astro";
import Infotekst from "@/components/infotekst/Infotekst.astro";
import type { Language } from "@/language/language";
import type { hentFraApi } from "@/server/apiClient";
import type { KontaktInfo as KontaktInfoData } from "@/types/kontaktInfo";
import type { Tlfnr } from "@/types/personalia";
import dkifStyles from "@/views/forside/kontaktinfo/Dkif.module.css";
import kontaktInfoStyles from "@/views/forside/kontaktinfo/KontaktInfo.module.css";
import Dkif from "./Dkif.astro";
import { text } from "./kontaktinfoText";

interface Props {
    language: Language;
    tlfnr?: Tlfnr;
    kontaktInfo: ReturnType<typeof hentFraApi<KontaktInfoData>>;
}

const { language, tlfnr, kontaktInfo } = Astro.props;

const hasTelefon = !!(tlfnr && (tlfnr.telefonHoved || tlfnr.telefonAlternativ));
---

<Box language={language} id="kontaktinformasjon" tittel={text.tittel[language]} ikon={kontaktIkon} ankerlenke>
    <Fragment slot="beskrivelse">{text.kilde[language]}</Fragment>
    {hasTelefon ? (
        <>
            <slot name="telefon" />
            <div class:list={["underseksjon__header", "underseksjon__divider", dkifStyles.overskriftContainer]}>
                <Heading size="small" level="3">{text.dkifOverskrift[language]}</Heading>
                <Infotekst language={language} tittel={text.dkifOverskrift[language]}>{text.dkifBeskrivelse[language]}</Infotekst>
            </div>
            <div class={kontaktInfoStyles.telefonnummer}>
                <Dkif language={language} kontaktInfo={kontaktInfo} />
            </div>
        </>
    ) : (
        <>
            <div class={kontaktInfoStyles.telefonnummer}>
                <Dkif language={language} kontaktInfo={kontaktInfo} />
            </div>
            <div class={kontaktInfoStyles.telefonnummer}>
                <slot name="telefon" />
            </div>
        </>
    )}
</Box>
