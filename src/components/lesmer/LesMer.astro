---
import { ChevronDownIcon } from "@navikt/aksel-icons";
import styles from "./LesMer.module.css";

interface Props {
    tittel: string;
    lukkTittel?: string;
    className?: string;
}

const { tittel, lukkTittel, className } = Astro.props;
---

<details class={`${styles.lesMer} ${className ?? ""}`}>
    <summary class={styles.knapp}>
        <ChevronDownIcon className={styles.chevron} aria-hidden={true} />
        <span class={styles.apne}>{tittel}</span>
        {lukkTittel && <span class={styles.lukk}>{lukkTittel}</span>}
    </summary>
    <div class={styles.innhold}><slot /></div>
</details>
