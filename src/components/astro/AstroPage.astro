---
import { getServerRuntimeConfig } from "@/config/serverRuntimeConfig";
import Layout from "@/layouts/Layout.astro";
import type { InitialData, Locale } from "@/store/Store";
import AstroPageRoot, { type AstroPage } from "./AstroPageRoot";

interface Props {
    page: AstroPage;
    locale: Locale;
    pathname: string;
    id?: string;
    tjeneste?: string;
    redirectUrl?: string;
    backTo?: string;
    initialData?: InitialData;
}

const { page, locale, pathname, id, tjeneste, redirectUrl, backTo, initialData } = Astro.props;
const validation = Astro.locals.validation;
const config = getServerRuntimeConfig(Astro.url);
const authName = validation?.ok && typeof validation.payload.name === "string" ? validation.payload.name : "";
---

<Layout title="Personopplysninger - www.nav.no">
    <AstroPageRoot
        client:load
        page={page}
        locale={locale}
        pathname={pathname}
        authName={authName}
        id={id}
        tjeneste={tjeneste}
        redirectUrl={redirectUrl}
        backTo={backTo}
        config={config}
        initialData={initialData}
    />
</Layout>
