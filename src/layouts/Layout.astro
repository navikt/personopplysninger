---
import "@navikt/ds-css";
import "@navikt/arbeidsforhold/index.css";
import { type DecoratorLocale, fetchDecoratorHtml } from "@navikt/nav-dekoratoren-moduler/ssr";
import { getServerRuntimeConfig } from "@/config/serverRuntimeConfig";
import "../styles/global.css";
import "../styles/tokens.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
const language = (Astro.currentLocale ?? "nb") as DecoratorLocale;
const { environment, appUrl, dittNavUrl } = getServerRuntimeConfig(Astro.url);
const decoratorEnvironment = environment === "prod" ? "prod" : "dev";

const decorator = await fetchDecoratorHtml({
    env: decoratorEnvironment,
    params: {
        context: "privatperson",
        language,
        breadcrumbs: [
            { url: dittNavUrl, title: "Min side" },
            { url: `${appUrl}/`, title: "Personopplysninger" },
        ],
        availableLanguages: [
            { url: `${appUrl}/nb/`, locale: "nb" },
            { url: `${appUrl}/en/`, locale: "en" },
            { url: `${appUrl}/nn/`, locale: "nn" },
        ],
        logoutWarning: true,
    },
});

const { DECORATOR_HEAD_ASSETS, DECORATOR_HEADER, DECORATOR_FOOTER, DECORATOR_SCRIPTS } = decorator;
---

<!doctype html>
<html lang={language}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <Fragment set:html={DECORATOR_HEAD_ASSETS} />
    </head>
    <body>
        <Fragment set:html={DECORATOR_HEADER} />
        <div class="pagewrapper">
            <main class="app" id="maincontent">
                <slot />
            </main>
        </div>
        <Fragment set:html={DECORATOR_FOOTER} />
        <Fragment set:html={DECORATOR_SCRIPTS} />
    </body>
</html>
