---
import "@navikt/ds-css";
import "@navikt/arbeidsforhold/index.css";
import { fetchDecoratorHtml } from "@navikt/nav-dekoratoren-moduler/ssr";
import { getServerRuntimeConfig } from "@/config/serverRuntimeConfig";
import type { Language } from "@/language/language";
import { text } from "@/language/text";
import { getSpraakvalg } from "@/utils/spraakvalg";
import "../styles/global.css";
import "../styles/tokens.css";

interface Props {
    title: string;
    brodsmuler?: { sti: string; tittel: string }[];
}

const { title, brodsmuler } = Astro.props;
const language = (Astro.currentLocale ?? "nb") as Language;
const { environment, appUrl, dittNavUrl, telemetryUrl, buildVersion } = getServerRuntimeConfig(Astro.url);
const decoratorEnvironment = environment === "prod" ? "prod" : "dev";
const sti = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, "").length);

const decorator = await fetchDecoratorHtml({
    env: decoratorEnvironment,
    params: {
        context: "privatperson",
        language,
        breadcrumbs: [
            { url: dittNavUrl, title: text.minSide[language] },
            { url: `${appUrl}/${language}/`, title: text.personopplysninger[language] },
            ...(brodsmuler ?? []).map((brodsmule) => ({ url: `${appUrl}/${language}${brodsmule.sti}`, title: brodsmule.tittel })),
        ],
        availableLanguages: getSpraakvalg(appUrl, sti),
        logoutWarning: true,
    },
});

const { DECORATOR_HEAD_ASSETS, DECORATOR_HEADER, DECORATOR_FOOTER, DECORATOR_SCRIPTS } = decorator;
---

<!doctype html>
<html lang={language}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <Fragment set:html={DECORATOR_HEAD_ASSETS} />
    </head>
    <body>
        <Fragment set:html={DECORATOR_HEADER} />
        <div class="pagewrapper">
            <main class="app" id="maincontent">
                <slot />
            </main>
        </div>
        <Fragment set:html={DECORATOR_FOOTER} />
        <Fragment set:html={DECORATOR_SCRIPTS} />
        <div hidden data-telemetry-url={telemetryUrl} data-environment={environment} data-build-version={buildVersion}></div>
        <script>
            import { startFaro } from "@/utils/faro";

            startFaro();
        </script>
    </body>
</html>
