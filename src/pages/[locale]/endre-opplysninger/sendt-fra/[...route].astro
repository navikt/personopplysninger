---
import { LOGIN_URL } from "astro:env/server";
import kontaktIkon from "@/assets/img/Kontakt.svg";
import Box from "@/components/box/Box.astro";
import ErrorMessage from "@/components/errorMessage/ErrorMessage";
import Redirect from "@/components/knapper/Redirect.astro";
import type { Language } from "@/language/language";
import Layout from "@/layouts/Layout.astro";
import { hentFraApi, loginUrlFor } from "@/server/apiClient";
import { personopplysningerApi } from "@/server/personopplysningerApi";
import styles from "@/styles/endreOpplysninger.module.css";
import type { PersonInfo } from "@/types/personInfo";
import { getApiUrl, getAppUrl } from "@/utils/environment";
import { redirects, tillatteTjenester, validateAndDecodeRedirectUrl } from "@/utils/redirects";
import Adresser from "@/views/forside/adresser/Adresser.astro";
import AndreAdresserOy from "@/views/forside/adresser/andre-adresser/AndreAdresserOy";
import { text } from "@/views/forside/kontaktinfo/kontaktinfoText";
import TelefonnummerOy from "@/views/forside/kontaktinfo/telefonnummer/TelefonnummerOy";
import Utbetalinger from "@/views/forside/utbetalinger/Utbetalinger.astro";

const language = (Astro.currentLocale ?? "nb") as Language;
const apiUrl = getApiUrl(Astro.url);
const appUrl = getAppUrl(Astro.url);

const segments = Astro.params.route?.split("/") ?? [];
const encodedUrl = segments.pop();
const tjeneste = segments.join("/");
const redirectUrl = validateAndDecodeRedirectUrl(encodedUrl);

if (!tillatteTjenester.includes(tjeneste) || !redirectUrl) {
    return Astro.redirect(`/person/personopplysninger/${language}/`);
}

const personInfo = await hentFraApi<PersonInfo>("/personalia", personopplysningerApi(Astro));
if (personInfo.status === "UNAUTHORIZED") {
    return Astro.redirect(loginUrlFor(Astro.url, import.meta.env.BASE_URL));
}

const personalia = personInfo.status === "RESULT" ? personInfo.data.personalia : undefined;
const adresser = personInfo.status === "RESULT" ? personInfo.data.adresser : undefined;

const kontaktadressePdl = adresser?.kontaktadresser.find((adr) => adr.kilde === "pdl");
const oppholdsadressePdl = adresser?.oppholdsadresser?.find((adr) => adr.kilde === "pdl");
const harAndre = !!(kontaktadressePdl ?? oppholdsadressePdl);
const andreAdresser = {
    kontaktadresser: kontaktadressePdl ? [kontaktadressePdl] : [],
    ...(oppholdsadressePdl && { oppholdsadresser: [oppholdsadressePdl] }),
};
---

<Layout title="Personopplysninger - www.nav.no">
    <div class="pagecontent">
        <div class="wrapper">
            <div class={styles.page}>
                <div class:list={[styles.container, "pagecontent"]}>
                    <Redirect redirect={redirects[tjeneste]} url={redirectUrl} />
                    {personInfo.status === "ERROR" && <ErrorMessage error={personInfo.error} />}
                    {personalia && (
                        <Box language={language} id="kontaktinformasjon" tittel={text.tittel[language]} ikon={kontaktIkon}>
                            <TelefonnummerOy
                                language={language}
                                tlfnr={personalia.tlfnr}
                                medOverskrift={false}
                                apiUrl={apiUrl}
                                appUrl={appUrl}
                                loginUrl={LOGIN_URL}
                                client:visible
                            />
                        </Box>
                    )}
                    {adresser && (
                        <Adresser language={language} adresser={adresser}>
                            {harAndre && (
                                <AndreAdresserOy
                                    slot="andre"
                                    language={language}
                                    adresser={andreAdresser}
                                    apiUrl={apiUrl}
                                    appUrl={appUrl}
                                    loginUrl={LOGIN_URL}
                                    client:visible
                                />
                            )}
                        </Adresser>
                    )}
                    {personalia && <Utbetalinger language={language} kontonr={personalia.kontonr} utenlandskbank={personalia.utenlandskbank} />}
                </div>
            </div>
        </div>
    </div>
</Layout>
