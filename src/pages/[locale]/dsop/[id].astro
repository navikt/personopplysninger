---
import DSOPIkon from "@/assets/img/DSOP.svg";
import ErrorMessage from "@/components/errorMessage/ErrorMessage";
import PageContainer from "@/components/pagecontainer/PageContainer.astro";
import type { Language } from "@/language/language";
import Layout from "@/layouts/Layout.astro";
import { hentFraApi, loginUrlFor } from "@/server/apiClient";
import { finnDsopInnslag, medData, svarstatus } from "@/server/historikk";
import { personopplysningerApi } from "@/server/personopplysningerApi";
import type { DsopInfo } from "@/types/dsop";
import { decodeRouteParam } from "@/utils/params";
import DsopDetaljer from "@/views/digital-samhandling-offentlig-privat/detaljer/DsopDetaljer.astro";
import { text } from "@/views/digital-samhandling-offentlig-privat/dsopText";
import PersonvernInfo from "@/views/digital-samhandling-offentlig-privat/PersonvernInfo.astro";

const language = Astro.currentLocale as Language;
const id = decodeRouteParam(Astro.params.id);

const sporingslogg = await hentFraApi<DsopInfo>("/sporingslogg", personopplysningerApi(Astro));
if (sporingslogg.status === "UNAUTHORIZED") {
    return Astro.redirect(loginUrlFor(Astro.url, import.meta.env.BASE_URL));
}

const innslag = medData(sporingslogg, (logg) => finnDsopInnslag(logg, id));
Astro.response.status = svarstatus(innslag);
---

<Layout
    title="Personopplysninger - www.nav.no"
    brodsmuler={[{ sti: "/dsop", tittel: text.tittel[language] }, { sti: `/dsop/${encodeURIComponent(id ?? "")}`, tittel: text.levertData[language] }]}
>
    <div class="pagecontent">
        <div class="wrapper">
            <PageContainer language={language} tittel={text.tittel[language]} ikon={DSOPIkon} tilbakeTil="/dsop">
                {innslag.status === "ERROR" && <ErrorMessage error={innslag.error} />}
                {innslag.status === "RESULT" && innslag.data && <DsopDetaljer language={language} innslag={innslag.data} />}
                {innslag.status === "RESULT" && !innslag.data && (
                    <div>
                        <PersonvernInfo language={language} ingenData={true} />
                    </div>
                )}
            </PageContainer>
        </div>
    </div>
</Layout>
