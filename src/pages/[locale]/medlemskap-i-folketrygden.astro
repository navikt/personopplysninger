---
import MEDLIkon from "@/assets/img/MEDL.svg";
import ErrorMessage from "@/components/errorMessage/ErrorMessage";
import PageContainer from "@/components/pagecontainer/PageContainer.astro";
import type { Language } from "@/language/language";
import Layout from "@/layouts/Layout.astro";
import { hentFraApi, loginUrlFor } from "@/server/apiClient";
import { personopplysningerApi } from "@/server/personopplysningerApi";
import type { MedlInfo } from "@/types/medl";
import MedlHistorikk from "@/views/medlemskap-i-folketrygden/MedlHistorikk.astro";
import { text } from "@/views/medlemskap-i-folketrygden/medlText";

const language = Astro.currentLocale as Language;

const medlInfo = await hentFraApi<MedlInfo>("/medl", personopplysningerApi(Astro));
if (medlInfo.status === "UNAUTHORIZED") {
    return Astro.redirect(loginUrlFor(Astro.url, import.meta.env.BASE_URL));
}
---

<Layout title="Personopplysninger - www.nav.no" brodsmuler={[{ sti: "/medlemskap-i-folketrygden", tittel: text.tittel[language] }]}>
    <div class="pagecontent">
        <div class="wrapper">
            <PageContainer language={language} tittel={text.tittel[language]} ikon={MEDLIkon} tilbakeTil="/#flere-opplysninger">
                {medlInfo.status === "RESULT" ? <MedlHistorikk language={language} medlInfo={medlInfo.data} /> : <ErrorMessage error={medlInfo.error} />}
            </PageContainer>
        </div>
    </div>
</Layout>
