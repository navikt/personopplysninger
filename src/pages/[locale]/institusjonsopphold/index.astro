---
import AstroPage from "@/components/astro/AstroPage.astro";
import { hentFraApi, loginUrlFor } from "@/server/apiClient";
import { personopplysningerApi } from "@/server/personopplysningerApi";
import type { Locale } from "@/store/Store";
import type { InstInfo } from "@/types/inst";

const locale = Astro.currentLocale as Locale;

const instInfo = await hentFraApi<InstInfo>("/institusjonsopphold", personopplysningerApi(Astro));
if (instInfo.status === "UNAUTHORIZED") {
    return Astro.redirect(loginUrlFor(Astro.url, import.meta.env.BASE_URL));
}
---

<AstroPage page="institusjonsoppholdHistorikk" locale={locale} pathname={Astro.url.pathname} instInfo={instInfo} />
